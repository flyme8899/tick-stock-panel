[Unit]
Description=TSP host news collector (DingTalk and Zsxq, read-only)
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/tick-stock-panel
Environment=HOME=/home/ubuntu
Environment=DATA_DIR=/home/ubuntu/tick-stock-panel/data
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/home/ubuntu/tick-stock-panel/.env
ExecStart=/usr/bin/python3 /home/ubuntu/tick-stock-panel/scripts/news_host_collector.py --data-dir /home/ubuntu/tick-stock-panel/data
TimeoutStartSec=3600
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/tick-stock-panel/data/news
# 只读采集。不要改成会发帖、评论或发送消息的命令。
# 仓库不在 /home/ubuntu/tick-stock-panel 时，改 WorkingDirectory、DATA_DIR、EnvironmentFile、ExecStart 和 ReadWritePaths。
# dws 若把登录态放在系统钥匙串或 Secret Service，systemd 没有用户 D-Bus 会话，服务里会看成未登录。部署后在同一单元里确认一次 dws auth status。
