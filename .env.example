# ===== TickFlow =====
# 留空或不填则启用 Free 试用模式(TickFlow.free()),仅能拿历史日 K 单股数据
TICKFLOW_API_KEY=

# ===== AI(可选,留空跳过 AI 功能) =====
AI_PROVIDER=openai_compat          # openai_compat | ollama
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_DAILY_TOKEN_BUDGET=500000

# ===== Server =====
HOST=0.0.0.0
PORT=3018
LOG_LEVEL=INFO
# 看门狗连续探测失败多少次后退出，交给进程管理器拉起。默认 2。
# WATCHDOG_FAILURE_THRESHOLD=2
# WATCHDOG_INTERVAL_S=30
# WATCHDOG_PROBE_TIMEOUT_S=15
# WATCHDOG_ENABLED=true

# ===== Auth =====
# 首次启动时预置访问密码(可选)。公网服务器部署时填入,免去 SSH 端口转发设密码。
# 仅在尚未设置共享密码时生效(一次性初始化);设过后改密码请用页面 UI, 此处不再读取。
# 建议至少 6 位。.env 文件权限保持 600 且不要提交到 Git。
# 登录页用户名填 admin, 或留空。这是旧版单密码登录, 与下面的多用户账号互相独立。
AUTH_PASSWORD=''

# 多用户账号。留空则使用 DATA_DIR/users.json（默认 ./data/users.json）。
# 也可填账号文件路径, 或内联 JSON（只放 Argon2id/bcrypt 哈希, 不要写明文）。
# 哈希里有 $, 写在 .env 时请用单引号。管理账号:
#   cd backend && uv run python ../scripts/manage_users.py add 用户名
# 生成的密码只在终端显示一次。各账号权限相同。
# AUTH_USERS=

# Optional backend dependency extras for Docker and ./dev.sh / .\dev.ps1.
# Set to legacy-cpu on older CPUs without AVX2/FMA support.
# Combine with backtest as: legacy-cpu backtest
BACKEND_EXTRAS=

# ===== Data =====
DATA_DIR=./data

# ===== 决策工作台（daily_stock_analysis sidecar，可选） =====
# 页面在侧栏「决策」。服务没启动时界面仍可打开，并标明未连接。
# 说明见 docs/dsa-integration.md。密钥留空则对应能力失败，不会拿空结果冒充分析。
DSA_BASE_URL=http://127.0.0.1:8000
DSA_AUTOSTART=0
DSA_PORT=8000
# DSA_PYTHON=
# DSA_UPSTREAM_COOKIE=
# 上游打开 ADMIN_AUTH_ENABLED 后，用管理密码自动登录并缓存 dsa_session。
# 过期时间跟随 Set-Cookie 的 Max-Age / Expires，并提前刷新，不写死 24 小时。
# 留空则只使用上面的 DSA_UPSTREAM_COOKIE，与未配置密码时相同。
# 不要把真实密码提交进仓库。
# DSA_PASSWORD=
# ETF 轮动入口的共享密钥。管理登录关闭、DSA 端口对外时，没有对应请求头的调用会被拒绝。
# 请求头名是 X-TSP-Internal-Token。TSP 与 DSA 读同一份 .env。至少 16 位可见 ASCII，不要提交真实值。
# DSA_INTERNAL_TOKEN=
# DSA_TIMEOUT_SECONDS=20
# 机械回测证据。scripts/dsa.sh 与 docker compose 默认使用仓库里的
# backend/app/custom/dsa/quant_evidence.yaml，并追加到同名 DSA 技能提示。
# 设为 off 可关闭。不要把这份文件放进 vendor strategies/，否则会被当成策略加载。
# TSP_QUANT_EVIDENCE_FILE=
# 自托管定时分析。容器时区固定为 Asia/Shanghai，下面的时刻是上海时间。
# SCHEDULE_ENABLED=true 后，sidecar 以 --serve-only 启动也会恢复每日任务，但不会立刻跑。
# 非交易日在 TRADING_DAY_CHECK_ENABLED=true 时跳过。自选写在 STOCK_LIST。
# 决策页「定时推送」保存时会写回本文件，因此 Docker 里这份 .env 不能只读。
# 跑完的报告出现在决策仪表盘，并使用下面的 Webhook / 邮件渠道推送。
SCHEDULE_ENABLED=false
SCHEDULE_TIME=18:00
SCHEDULE_RUN_IMMEDIATELY=false
TRADING_DAY_CHECK_ENABLED=true
MARKET_REVIEW_ENABLED=true
MARKET_REVIEW_REGION=cn
# STOCK_LIST=600519,000858
# 未单独填写时，scripts/dsa.sh 会借用上面的 AI_API_KEY / AI_BASE_URL / AI_MODEL。
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# AIHUBMIX_KEY=
# ANSPIRE_API_KEYS=
# TUSHARE_TOKEN=
# 新闻搜索，至少配一个分析质量会好很多。
# SERPAPI_API_KEYS=
# TAVILY_API_KEYS=
# BOCHA_API_KEYS=
# BRAVE_API_KEYS=
# MINIMAX_API_KEYS=
# SEARXNG_BASE_URLS=
# 定时报告的通知渠道。和设置页里监控/复盘用的渠道互不覆盖。
# WECHAT_WEBHOOK_URL=
# FEISHU_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# DISCORD_WEBHOOK_URL=
# SLACK_BOT_TOKEN=
# SLACK_CHANNEL_ID=
# EMAIL_SENDER=
# EMAIL_PASSWORD=
# ETF_ROTATION_POOL=510300,510500,159915,512890,513100,518880
# ETF_ROTATION_SAFE_ASSET=511880
# 决策页「多市场选股」。false 时 DSA 拒绝选股（screening_disabled）。
SCREENING_ENABLED=false
# 日 K 源优先级，数字越小越优先。TickFlow 默认 2。
# efinance 默认 0，会排在 TickFlow 前面。设为 3 后 TickFlow 先于 efinance。
# AkShare 默认仍是 1。已登记指数的日 K，以及实时行情，不使用这个值。改完后重启 sidecar。
EFINANCE_PRIORITY=3

# ===== 多源资讯（默认关闭，说明见 docs/news-sources.md） =====
# 环境变量优先于热门事件页上的开关。留空则关闭，已有部署不会开始出网。
NEWS_DWS_ENABLED=
NEWS_ZSXQ_ENABLED=
NEWS_IMA_ENABLED=
NEWS_CLS_ENABLED=
NEWS_WSCN_ENABLED=
NEWS_ETF_FLOW_ENABLED=
NEWS_CNBC_ENABLED=
NEWS_MARKETWATCH_ENABLED=
NEWS_WSJ_ENABLED=
NEWS_BLOOMBERG_ENABLED=
NEWS_SCMP_ENABLED=
NEWS_REUTERS_ENABLED=
NEWS_SEC_ENABLED=
# SEC 最新 8-K。User-Agent 必须包含联系邮箱，否则来源保持未配置、不会出网。
# SEC_USER_AGENT=TSP-News ops@example.com
# NEWS_LLM_EXTRACT=false
# ETF领航者申赎表格的视觉模型。和上面的 AI_API_KEY / AI_BASE_URL / AI_MODEL 分开。
# 没填 VISION_AI_API_KEY 时，这个来源保持未配置。
# 不要复用 AI_API_KEY。默认模型会读图片。
# 申赎表格保持思考，max_tokens 为 8192；关掉思考会让表格识别变差。
# 备选：glm-5.3-flash、mimo-v2.6-flash。不把备选写成默认。
# VISION_AI_API_KEY=
# VISION_AI_BASE_URL=https://tokenhub.tencentmaas.com/v1
# VISION_AI_MODEL=deepseek/deepseek-v4-flash-vision-exp
# 钉钉群号、知识星球号。留空表示未配置，对应来源无法开启。
# NEWS_DWS_GROUP_ID=
# NEWS_ZSXQ_GROUP_ID=
# IMA_CLIENT_ID=
# IMA_API_KEY=
# IMA_KB_ID=
# 登录失效提醒，以及热门事件页的候选推送，共用这一个自定义机器人。两条路径文案分开。
# DINGTALK_WEBHOOK_URL=
# DINGTALK_SECRET=
# 推送默认全关。总开关和对应类型都要打开才会发。时间是北京时间，只在交易日。
# NEWS_PUSH_ENABLED=false
# NEWS_PUSH_HOT_ENABLED=false
# NEWS_PUSH_ABNORMAL_ENABLED=false
# NEWS_PUSH_T_ENABLED=false
# NEWS_PUSH_PREMARKET=08:45
# NEWS_PUSH_POSTCLOSE=15:40
# NEWS_PUSH_TOP_N=5
# NEWS_PUSH_MIN_STORIES=2
# NEWS_PUSH_SCORE_JUMP=0.5
# 异动是否把热门个股并入自选。做T默认只看自选，下面打开后才把模拟持仓并进去。
# NEWS_PUSH_ABNORMAL_INCLUDE_HOT=false
# NEWS_PUSH_T_INCLUDE_POSITIONS=false
# 做T：均价偏离默认 ±1.5%，贴近高低 0.3%。均价和回到昨收的冷却默认 60 分钟。
# 贴近高低单独冷却，默认也是 60 分钟。打开下面这项后，这两条合计每只股票每天最多一条。
# 10:00 之前不推贴近高低。全自选当天做T消息默认最多 20 条，0 表示不限制。
# NEWS_PUSH_T_COOLDOWN_MIN=60
# NEWS_PUSH_T_RANGE_COOLDOWN_MIN=60
# NEWS_PUSH_T_RANGE_ONCE_PER_DAY=false
# NEWS_PUSH_T_DAILY_CAP=20
# DSA 拉取 /api/news/dsa-feed 的令牌。至少 32 字节随机串，只放请求头 X-News-Feed-Token，不要放进 URL。
# 留空则情报桥不工作，DSA 仍可启动。
# 本地默认 http://127.0.0.1:3018；Docker compose 的 dsa 服务固定为 http://app:3018。
# NEWS_DSA_FEED_TOKEN=
# TSP_NEWS_BASE_URL=http://127.0.0.1:3018
