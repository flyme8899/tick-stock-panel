# ===== TickFlow =====
# 留空或不填则启用 Free 试用模式(TickFlow.free()),仅能拿历史日 K 单股数据
TICKFLOW_API_KEY=

# ===== AI(可选,留空跳过 AI 功能) =====
AI_PROVIDER=openai_compat          # openai_compat | ollama
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_DAILY_TOKEN_BUDGET=500000

# ===== Server =====
HOST=0.0.0.0
PORT=3018
LOG_LEVEL=INFO
# 看门狗连续探测失败多少次后退出，交给进程管理器拉起。默认 2。
# WATCHDOG_FAILURE_THRESHOLD=2
# WATCHDOG_INTERVAL_S=30
# WATCHDOG_PROBE_TIMEOUT_S=15
# WATCHDOG_ENABLED=true

# ===== Auth =====
# 首次启动时预置访问密码(可选)。公网服务器部署时填入,免去 SSH 端口转发设密码。
# 仅在尚未设置共享密码时生效(一次性初始化);设过后改密码请用页面 UI, 此处不再读取。
# 建议至少 6 位。.env 文件权限保持 600 且不要提交到 Git。
# 登录页用户名填 admin, 或留空。这是旧版单密码登录, 与下面的多用户账号互相独立。
AUTH_PASSWORD=''

# 多用户账号。留空则使用 DATA_DIR/users.json（默认 ./data/users.json）。
# 也可填账号文件路径, 或内联 JSON（只放 Argon2id/bcrypt 哈希, 不要写明文）。
# 哈希里有 $, 写在 .env 时请用单引号。管理账号:
#   cd backend && uv run python ../scripts/manage_users.py add 用户名
# 生成的密码只在终端显示一次。各账号权限相同。
# AUTH_USERS=

# Optional backend dependency extras for Docker and ./dev.sh / .\dev.ps1.
# Set to legacy-cpu on older CPUs without AVX2/FMA support.
# Combine with backtest as: legacy-cpu backtest
BACKEND_EXTRAS=

# ===== Data =====
DATA_DIR=./data

# 容器进程的 uid/gid。app 和 dsa 都用这一对，compose 默认 1000:1000。
# 生产机 ubuntu 的主组经常是 1001，那时把 APP_GID 改成 1001。
# 已经用 root 写过 data/ 的机器，先停容器再改属主。生产机示例:
#   sudo chown -R 1000:1001 data
#   sudo chown 1000:1001 .env
# 数字要和下面两行一致。回滚为 root: 改成 0 和 0。见 docs/deployment.md。
APP_UID=1000
APP_GID=1000

# ===== 决策工作台（daily_stock_analysis sidecar，可选） =====
# 页面在侧栏「决策」。服务没启动时界面仍可打开，并标明未连接。
# 说明见 docs/dsa-integration.md。密钥留空则对应能力失败，不会拿空结果冒充分析。
DSA_BASE_URL=http://127.0.0.1:8000
DSA_AUTOSTART=0
DSA_PORT=8000
# DSA_PYTHON=
# DSA_UPSTREAM_COOKIE=
# 上游打开 ADMIN_AUTH_ENABLED 后，用管理密码自动登录并缓存 dsa_session。
# 过期时间跟随 Set-Cookie 的 Max-Age / Expires，并提前刷新，不写死 24 小时。
# 留空则只使用上面的 DSA_UPSTREAM_COOKIE，与未配置密码时相同。
# 不要把真实密码提交进仓库。
# DSA_PASSWORD=
# ETF 轮动入口的共享密钥。管理登录关闭、DSA 端口对外时，没有对应请求头的调用会被拒绝。
# 请求头名是 X-TSP-Internal-Token。TSP 与 DSA 读同一份 .env。至少 16 位可见 ASCII，不要提交真实值。
# DSA_INTERNAL_TOKEN=
# DSA_TIMEOUT_SECONDS=20
# 机械回测证据。scripts/dsa.sh 与 docker compose 默认使用仓库里的
# backend/app/custom/dsa/quant_evidence.yaml，并追加到同名 DSA 技能提示。
# 设为 off 可关闭。不要把这份文件放进 vendor strategies/，否则会被当成策略加载。
# TSP_QUANT_EVIDENCE_FILE=
# 自托管定时分析。容器时区固定为 Asia/Shanghai，下面的时刻是上海时间。
# SCHEDULE_ENABLED=true 后，sidecar 以 --serve-only 启动也会恢复每日任务，但不会立刻跑。
# 非交易日在 TRADING_DAY_CHECK_ENABLED=true 时跳过。自选写在 STOCK_LIST。
# 决策页「定时推送」保存时会写回本文件，因此 Docker 里这份 .env 不能只读。
# 跑完的报告出现在决策仪表盘，并使用下面的 Webhook / 邮件渠道推送。
SCHEDULE_ENABLED=false
SCHEDULE_TIME=18:00
SCHEDULE_RUN_IMMEDIATELY=false
TRADING_DAY_CHECK_ENABLED=true
MARKET_REVIEW_ENABLED=true
MARKET_REVIEW_REGION=cn
# STOCK_LIST=600519,000858
# 未单独填写时，scripts/dsa.sh 会借用上面的 AI_API_KEY / AI_BASE_URL / AI_MODEL。
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# AIHUBMIX_KEY=
# ANSPIRE_API_KEYS=
# TUSHARE_TOKEN=
# 新闻搜索，至少配一个分析质量会好很多。
# SERPAPI_API_KEYS=
# TAVILY_API_KEYS=
# BOCHA_API_KEYS=
# BRAVE_API_KEYS=
# MINIMAX_API_KEYS=
# SEARXNG_BASE_URLS=
# 定时报告的通知渠道。和设置页里监控/复盘用的渠道互不覆盖。
# WECHAT_WEBHOOK_URL=
# FEISHU_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# DISCORD_WEBHOOK_URL=
# SLACK_BOT_TOKEN=
# SLACK_CHANNEL_ID=
# EMAIL_SENDER=
# EMAIL_PASSWORD=
# ETF 轮动。不设置 MODE 时用分桶混合动量：20/60/120 日收益的平均排名，
# A 股桶只留最强的一只，每月调仓，持有前 3，按 60 日波动率倒数加权。
# 入选桶少于 3 个时，剩余仓位才买入 511880。信号在收盘产生，下一交易日收盘执行。
# equal_weight = 下面 6 只等权、每月再平衡。legacy = 旧的周频单窗口前 2。
# 组合回撤风控默认关闭。TickFlow 日线按 TICKFLOW_PRIORITY 参加，并在这次请求里用前复权。
# ETF_ROTATION_MODE=blended_bucket
# ETF_ROTATION_LOOKBACKS=20,60,120
# ETF_ROTATION_BUCKETS=A股:510300|510500|159915;红利:512890;海外:513100;商品:518880
# ETF_ROTATION_REBALANCE=monthly
# ETF_ROTATION_TOP_N=3
# ETF_ROTATION_WEIGHTING=inv_vol
# ETF_ROTATION_DRAWDOWN_RISK_OFF=false
# ETF_ROTATION_POOL=510300,510500,159915,512890,513100,518880
# ETF_ROTATION_SAFE_ASSET=511880
# 决策页「多市场选股」。false 时 DSA 拒绝选股（screening_disabled）。
SCREENING_ENABLED=false
# 日 K 源优先级，数字越小越优先。TickFlow 默认 2。
# efinance 默认 0，会排在 TickFlow 前面。设为 3 后 TickFlow 先于 efinance。
# AkShare 默认仍是 1。已登记指数的日 K，以及实时行情，不使用这个值。改完后重启 sidecar。
EFINANCE_PRIORITY=3

# ===== 多源资讯（默认关闭，说明见 docs/news-sources.md） =====
# 环境变量优先于热门事件页上的开关。留空则关闭，已有部署不会开始出网。
NEWS_DWS_ENABLED=
NEWS_ZSXQ_ENABLED=
NEWS_IMA_ENABLED=
NEWS_CLS_ENABLED=
NEWS_WSCN_ENABLED=
# 格隆汇快讯。公开接口，不需要登录。留空时默认打开，页面可以关。写成 false 则关闭且页面不能改。
NEWS_GLH_ENABLED=
NEWS_ETF_FLOW_ENABLED=
NEWS_CNBC_ENABLED=
NEWS_MARKETWATCH_ENABLED=
NEWS_WSJ_ENABLED=
NEWS_BLOOMBERG_ENABLED=
NEWS_SCMP_ENABLED=
NEWS_REUTERS_ENABLED=
NEWS_REDDIT_ENABLED=
# 逗号分隔。留空时用 wallstreetbets,stocks,investing。JSON 接口会 403，只拉 /new/.rss。
# NEWS_REDDIT_SUBREDDITS=wallstreetbets,stocks,investing
# 预留。当前采集不换 token，请求里也不带 Authorization。
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
NEWS_SEC_ENABLED=
# SEC 最新 8-K。User-Agent 必须包含联系邮箱，否则来源保持未配置、不会出网。
# SEC_USER_AGENT=TSP-News ops@example.com
# NEWS_LLM_EXTRACT=false
# ETF领航者申赎表格的视觉模型。和上面的 AI_API_KEY / AI_BASE_URL / AI_MODEL 分开。
# 没填 VISION_AI_API_KEY 时，这个来源保持未配置。
# 不要复用 AI_API_KEY。默认模型会读图片。
# 申赎表格保持思考，max_tokens 为 8192；关掉思考会让表格识别变差。
# 备选：glm-5.3-flash、mimo-v2.6-flash。不把备选写成默认。
# VISION_AI_API_KEY=
# VISION_AI_BASE_URL=https://tokenhub.tencentmaas.com/v1
# VISION_AI_MODEL=deepseek/deepseek-v4-flash-vision-exp
# 钉钉群号、知识星球号。留空表示未配置，对应来源无法开启。
# NEWS_DWS_GROUP_ID=
# NEWS_ZSXQ_GROUP_ID=
# IMA_CLIENT_ID=
# IMA_API_KEY=
# IMA_KB_ID=
# 个人知识库「莽的知识库」的券商研报全文。ID 不要写进代码。留空则这条来源未配置。
# 用户每天 0:30 开始转存前一天的稿，所以默认 06:30 和 08:30 各拉一次。
# IMA_RESEARCH_KB_ID=ak-X2lYob-kG7ynbrrHCsGUY4g6kjGEW1R10JlE24lo=
# IMA_RESEARCH_TIMES=06:30,08:30
# NEWS_IMA_RESEARCH_ENABLED=false
# 登录失效提醒，以及热门事件页的候选推送，共用这一个自定义机器人。两条路径文案分开。
# DINGTALK_WEBHOOK_URL=
# DINGTALK_SECRET=
# 推送默认全关。总开关和对应类型都要打开才会发。时间是北京时间，只在交易日。
# NEWS_PUSH_ENABLED=false
# NEWS_PUSH_HOT_ENABLED=false
# NEWS_PUSH_ABNORMAL_ENABLED=false
# NEWS_PUSH_T_ENABLED=false
# NEWS_PUSH_PREMARKET=08:45
# NEWS_PUSH_POSTCLOSE=15:40
# NEWS_PUSH_TOP_N=5
# NEWS_PUSH_MIN_STORIES=2
# NEWS_PUSH_SCORE_JUMP=0.5
# 异动是否把热门个股并入自选。做T默认只看自选，下面打开后才把模拟持仓并进去。
# NEWS_PUSH_ABNORMAL_INCLUDE_HOT=false
# NEWS_PUSH_T_INCLUDE_POSITIONS=false
# 做T：均价偏离默认 ±1.5%，贴近高低 0.3%。均价和回到昨收的冷却默认 60 分钟。
# 贴近高低单独冷却，默认也是 60 分钟。打开下面这项后，这两条合计每只股票每天最多一条。
# 10:00 之前不推贴近高低。全自选当天做T消息默认最多 20 条，0 表示不限制。
# NEWS_PUSH_T_COOLDOWN_MIN=60
# NEWS_PUSH_T_RANGE_COOLDOWN_MIN=60
# NEWS_PUSH_T_RANGE_ONCE_PER_DAY=false
# NEWS_PUSH_T_DAILY_CAP=20
# DSA 拉取 /api/news/dsa-feed 的令牌。至少 32 字节随机串，只放请求头 X-News-Feed-Token，不要放进 URL。
# 留空则情报桥不工作，DSA 仍可启动。
# 本地默认 http://127.0.0.1:3018；Docker compose 的 dsa 服务固定为 http://app:3018。
# NEWS_DSA_FEED_TOKEN=
# TSP_NEWS_BASE_URL=http://127.0.0.1:3018

# ===== A 股资金进出 =====
# 代码默认关闭：下面这些变量不出现在进程环境里时，不调度、不出网。
# 本 HK 部署按源探测结果打开。个股用显式 secid 请求东财 push2his 日频账单，
# 不再走 efinance 的代码搜索。逐只请求失败或熔断后，已拿到的行照常落盘；
# 还没请求的代码改走同花顺全市场排名（stock_fund_flow_individual），
# 不行再用东财 stock_individual_fund_flow_rank。这两份只补当日和 5 日合计。
# 不用逐只的 ak.stock_individual_fund_flow / stock_main_fund_flow，也不用东财 push2 板块接口。
# 开关在非交易日或收盘前提前打开时，会补最近一个还没落盘的交易日。
# 北向净流入自 2024-08-16 起没有数据，这里只开成交额。
FUND_FLOW_ENABLED=true
FUND_FLOW_STOCK=true
# 盘中资金净额(同花顺)。总开关打开且本变量未设置时默认开启。
# 交易日连续竞价（北京时间 9:30–11:30、13:00–15:00）每 6 分钟拉一次
# 同花顺 stock_fund_flow_individual(symbol="即时") 的「净额」（流入减流出，
# 不是东财主力净流入），走共用限流和超时。
# 午休、收盘后、周末不拉，也不补历史。写成 false 才关闭。
FUND_FLOW_STOCK_INTRADAY=true
FUND_FLOW_SECTOR=true
FUND_FLOW_MARGIN=true
FUND_FLOW_ETF_SHARES=true
FUND_FLOW_SOUTHBOUND=true
FUND_FLOW_NORTHBOUND_TURNOVER=true
FUND_FLOW_LHB_BACKUP=true
# 妙想只补已经请求过、但东财没有返回的代码。熔断后还没轮到的代码不进妙想。
# 留空则跳过，不消耗配额。单轮调用上限默认 30。
# 接口如果返回剩余次数，用这个剩余次数继续判断；同时仍受上面的单轮上限约束。
# MX_APIKEY=
# FUND_FLOW_MX_MAX_CALLS=30

# ===== 打板与研报 =====
# 代码默认打开：环境变量不出现时也会拉数。设为 false 才关闭。
# 东财涨停/炸板/跌停/昨日涨停池和研报列表共用一把限流，默认至少间隔 1 秒。
# EASTMONEY_MIN_INTERVAL 低于 0.5 时仍按 0.5，也就是最快 2 次/秒。
# 连续失败或 HTTP 403 会熔断约 10 分钟。不下载 PDF。
# 同花顺涨停揭秘先探活。本机在海外时探不到就跳过，东财池子照常落盘。
# NEWS_RESEARCH_ENABLED 锁住热门事件里的「研报」来源。true 时写入资讯库，false 时只落盘不进热门事件。
LIMIT_BOARD_ENABLED=true
LIMIT_BOARD_EASTMONEY=true
LIMIT_BOARD_THS=true
RESEARCH_ENABLED=true
RESEARCH_STOCK=true
RESEARCH_INDUSTRY=true
EASTMONEY_MIN_INTERVAL=1.0
NEWS_RESEARCH_ENABLED=true
# 每轮只同步一批个股，避免和收盘快照抢东财配额。行业列表默认只回溯 14 天。
# RESEARCH_BATCH_SIZE=8
# RESEARCH_MAX_SYMBOLS=40

# ===== 选股补充字段 =====
# 代码默认关闭：这些变量不出现在进程环境里时，不调度、不出网。
# 总开关打开后，下面的子开关才生效。收盘后由单独线程拉取，不占后端重任务槽。
# 交易日 15:10 之前不拉。周末、节假日和每个工作日 09:35 之前，补上一交易日还没落盘的数据。
# 股东户数、解禁明细、PE(TTM) 走东财。限速只包住本模块自己的请求，不替换其它线程的网络访问。
# PE 默认间隔仍是 EASTMONEY_MIN_INTERVAL 的 1 秒。
# 北向持股约 16:20，拉最近一个有数据的季度（占流通股比）。港交所 2024-08 起停了逐日持股，不再请求那个接口。
# 页面表头是「北向持股(季)」，并注明截至日期。
# 股东户数约 16:30：源头是季报，每个交易日收盘后刷新一次「最新」。
# 指数成分约 16:40。沪深300、上证50、中证500、中证1000 来自中证指数公司；创业板50 来自国证指数。
# 都不走东财限速。每只指数单独落盘，一只失败不影响其余指数。
# 中证、国证、东财请求默认连接 10 秒、读取 30 秒。
# 单个子任务超时后记下失败，并让该线程在当前请求结束后停下来。
# 旧线程还在跑时不再开新线程，避免两套进度同时写盘。线程退出后，下一轮继续后面的任务。
# 解禁时间表约 16:50，窗口是当天起 120 天，每只股票只留最近一次。
# PE(TTM) 约 17:10 起先按交易日拉东财估值全市场分页（字段 PE_TTM，每页 500 只）。
# 全市场大约十几次请求。行情列表里的市盈率(动) 不是 TTM，这里不用。
# 分页里没有的代码才逐只补历史估值。单只失败直接跳过，不再停 30 秒。
# 中断后从上次页码续跑，已写入的代码不重复请求。
# 周线、月线、连涨天数用本地日 K 现算，没有单独开关，也不出网。
# 某一项失败时，策略结果仍显示已有行，并标明缺了哪一项。
SELECTION_FIELDS_ENABLED=true
SELECTION_NORTHBOUND=true
SELECTION_HOLDERS=true
SELECTION_INDEX_MEMBERS=true
SELECTION_UNLOCK=true
SELECTION_PE_TTM=true
# 每写入多少只 PE 就落一次盘。默认 25。
# SELECTION_PE_FLUSH_EVERY=25

# ===== 个股事件上下文 =====
# 龙虎榜明细、两融个股明细、互动易/e互动、全市场公告、盘口异动。
# 代码默认关闭：这些变量不出现在进程环境里时，不调度、不出网。
# 总开关关闭时，下面的子开关不生效。
# 给 DSA 个股分析和热门事件确认用。底层东财请求走统一限速，只包住这个线程。
# 连接超时 10 秒，读取超时 30 秒。每个子任务有整体超时；超时后不再开第二个线程。
# 某一项拉空或失败时，保留上次成功的分区，并在热门事件健康页标注。
# 龙虎榜约 17:40 拉当天明细（净买额、营业部）。两融约 20:10，或次日开盘前补上一交易日。
# 东财当天没有深市时改读深交所明细；深交所也没有则只写沪市并标注。
# 互动问答只拉自选和热门事件相关个股，每次几只，增量。公告增量落在事件上下文，个股分析直接读。
# 业绩预告、重组、回购、增减持、立案每次最多 40 条进入热门事件。不再使用返回 0 条的巨潮接口。
# 盘口异动在 9:35–15:00 约 10 分钟拉一次。
EVENT_CONTEXT_ENABLED=true
EVENT_CONTEXT_LHB=true
EVENT_CONTEXT_MARGIN=true
EVENT_CONTEXT_QA=true
EVENT_CONTEXT_NOTICE=true
EVENT_CONTEXT_CHANGES=true
